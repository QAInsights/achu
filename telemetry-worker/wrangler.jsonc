{
	"name": "achu-telemetry",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-22",
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "achu-telemetry",
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations"
		}
	],
	"routes": [
		{ "pattern": "telemetry.achu.app", "custom_domain": true }
	],
	"ratelimits": [
		{
			"name": "PING_LIMITER",
			"namespace_id": "1002",
			"simple": {
				"limit": 10,
				"period": 60
			}
		}
	]
}
