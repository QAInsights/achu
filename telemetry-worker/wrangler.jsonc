{
	"name": "achu-telemetry",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-22",
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "achu-telemetry",
			"database_id": "dd00661e-6571-4583-918a-b28a6fddbb44",
			"migrations_dir": "migrations"
		}
	],
	"routes": [
		{
			"pattern": "telemetry.achu.app",
			"custom_domain": true
		}
	],
	"ratelimits": [
		{
			"name": "PING_LIMITER",
			"namespace_id": "1002",
			"simple": {
				"limit": 10,
				"period": 60
			}
		},
		{
			"name": "LOGIN_LIMITER",
			"namespace_id": "1003",
			"simple": {
				"limit": 5,
				"period": 60
			}
		}
	]
}