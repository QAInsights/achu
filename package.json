{
  "name": "achu",
  "version": "2026.5.30",
  "description": "A lightweight Windows desktop application for beautifying screenshots.",
  "main": "main.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "node scripts/build.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "package": "npm run build && electron-builder --win portable"
  },
  "keywords": [],
  "author": "NaveenKumar Namachivayam <catch.nkn@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "geist": "1.7.1",
    "jsonrepair": "^3.14.0",
    "lucide-react": "^0.435.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^4.1.7",
    "c8": "^10.1.3",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.23.1",
    "jsdom": "^29.1.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vitest": "^4.1.7"
  },
  "build": {
    "appId": "com.navee.achu",
    "productName": "Achu",
    "directories": {
      "output": "release"
    },
    "files": [
      {
        "from": "app-bundle",
        "to": "."
      },
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "assets/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": "universal"
        },
        {
          "target": "zip",
          "arch": "universal"
        }
      ],
      "category": "public.app-category.graphics-design"
    },
    "linux": {
      "icon": "assets/icon-256.png",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Graphics"
    }
  }
}
